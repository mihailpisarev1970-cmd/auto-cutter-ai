# ==========================================
# Polza AI Gateway (Обязательно для AI-нарезки)
# ==========================================
# Получите ваш ключ на https://polza.ai/
POLZA_API_KEY=your_polza_api_key_here
POLZA_BASE_URL=https://polza.ai/api/v1

# Модель по умолчанию (если не указана, возьмется первая из списка)
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Доступные модели в формате JSON для выпадающего списка в Gradio
AVAILABLE_LLM_MODELS=[{"label":"GPT-4o mini","value":"openai/gpt-4o-mini"},{"label":"DeepSeek Chat","value":"deepseek/deepseek-chat"}]

# ==========================================
# Настройки Whisper (Модели распознавания речи)
# ==========================================
WHISPER_BASE_MODEL=base
WHISPER_SUBTITLES_MODEL=small

# ==========================================
# Настройки видео и субтитров
# ==========================================
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
SUBTITLE_FONT_SIZE=64
SUBTITLE_MARGIN_V=440